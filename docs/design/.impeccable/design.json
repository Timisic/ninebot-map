  "narrative": {
    "northStar": "地图与稳定的停靠面板",
    "overview": "地图独立占据可视区域，地点面板停靠于右侧或底部。统计与日期在左上，图层与视角控件在右下。单次路线清晰，重复路线按主题增强。",
    "keyCharacteristics": [
      "选择与命名分开，关闭面板保留草稿。",
      "地图给面板留出空间。",
      "本地数据、未知坐标声明和离线默认保持可见。"
    ],
    "rules": [
      {
        "name": "Routes and basemap",
        "body": "每条路线有可见底线。暗色重复路线变亮，浅色重复路线变深。连续缩放保留已加载瓦片。",
        "section": "colors"
      }
    ],
    "dos": [
      "Do 让地图保持主视觉，说明通过展开控件提供。",
      "Do 将地图针的16px图形与44px点击区域分开设置。",
      "Do 保留键盘焦点、可访问名称与减少动画支持。"
    ],
    "donts": [
      "Don't 用大型地图针、编号气泡或常驻宽列表遮挡路线。",
      "Don't 将 OilUI 或 Trail 设计参考描述成复制的源码。"
